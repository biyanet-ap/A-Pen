<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for the Microsoft Store. packaging\build-msix.ps1 fills in Version from AppVersion in src\HighPen.cs.
     Identity Name / Publisher and PublisherDisplayName must match Partner Center > Product identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="StephenWon.HighPen" Publisher="CN=58BB6EA5-E7A7-4A4F-9A0C-62261149B3A1" Version="$Version$" ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>HighPen</DisplayName>
    <PublisherDisplayName>StephenWon</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ko-kr" />
    <Resource Language="ja-jp" />
  </Resources>

  <Applications>
    <Application Id="HighPen" Executable="HighPen.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="HighPen"
        Description="A Windows pen app for online lectures"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- a classic desktop app (global hotkeys, full-screen overlay) -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
